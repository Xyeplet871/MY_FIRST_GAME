[sub_resource type="GDScript" id="GDScript_jqdra"]
script/source = "extends Area2D


@export var target_scene_path: String = \"res://Level2.tscn\"



func _ready():
	body_entered.connect(_on_body_entered)

func _on_body_entered(body):if body.name == \"Player\":  # Проверяем, что это игрок
	get_tree().change_scene_to_file(target_scene_path)

	$AnimatedSprite2D.play(\"res://portall.tscn\")
"

